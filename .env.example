# ===== 应用 =====
SECRET_KEY=change-me-to-a-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== PostgreSQL =====
# 端口 5433 是本仓库统一口径（README / 学习指南 / docker-compose 一致），不要改回 5432；
# - Docker 路径（docker compose up 起 PG）：下面默认值与 docker-compose.yml 对齐，copy 后即可用；
# - 原生 PG 路径（本机安装的 PostgreSQL）：把 PG_PASSWORD 改成你自己的 postgres 密码，
#   端口保持 5433（若你的 postgresql.conf 监听别的端口，则两处一起改）。
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=local-trust
PG_DB=lunjiang

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ===== LLM Provider（在 configs/settings.yaml 中切换 default_provider）=====
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
# 注：settings.yaml 无 openai provider，OPENAI_API_KEY 已移除（无效残留键）

# agnes-2.5-flash（OpenAI 兼容 /chat/completions）
AGNES_BASE_URL=https://ai.furry.vg/v1
AGNES_API_KEY=your-agnes-key
